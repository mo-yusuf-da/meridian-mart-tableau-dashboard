      </column>
      <column caption='Discount Band ' datatype='string' name='[Calculation_1557238048899075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;0%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.1 THEN &quot;1-10%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.2 THEN &quot;11-20%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.3 THEN &quot;21-30%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.5 THEN &quot;31-50%&quot;&#13;&#10;                     ELSE &quot;&gt;50%&quot; END' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_1557238048968708]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;Loss&quot; ELSE &quot;Profit&quot; END' />
      </column>
      <column caption='Customer Label' datatype='string' name='[Calculation_1557238049026053]' role='dimension' type='nominal'>
