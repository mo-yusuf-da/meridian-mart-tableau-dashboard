    <worksheet name='Discount Band'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#595959' fontname='JetBrains Mono,ui-monospace,monospace' fontsize='10'>SALES, PROFIT, AND PROFIT MARGIN BY DISCOUNT BAND</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales+ (Meridian Mart Data - Sales Analysis)' name='federated.1s5vqj20c20fh211pelmb0asn3el' />
          </datasources>
          <datasource-dependencies datasource='federated.1s5vqj20c20fh211pelmb0asn3el'>
            <column caption='Profit Margin' datatype='real' default-format='p0.0%' name='[Calculation_1557238048464896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
            </column>
            <column caption='Discount Band ' datatype='string' name='[Calculation_1557238048899075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;0%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.1 THEN &quot;1-10%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.2 THEN &quot;11-20%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.3 THEN &quot;21-30%&quot;&#13;&#10;                     ELSEIF [Discount] &lt;= 0.5 THEN &quot;31-50%&quot;&#13;&#10;                     ELSE &quot;&gt;50%&quot; END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='real' default-format='p0%' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='C4105%' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Sales (Sales)' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1557238048899075]' derivation='None' name='[none:Calculation_1557238048899075:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment]' derivation='None' name='[none:Segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Profit]' derivation='Sum' name='[sum:Profit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Year-Trunc' name='[tyr:Order Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1557238048464896]' derivation='User' name='[usr:Calculation_1557238048464896:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1s5vqj20c20fh211pelmb0asn3el].[none:Category:nk]</column>
            <column>[federated.1s5vqj20c20fh211pelmb0asn3el].[none:Segment:nk]</column>
