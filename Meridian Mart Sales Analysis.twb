            <column>[federated.1s5vqj20c20fh211pelmb0asn3el].[tyr:Order Date:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.1s5vqj20c20fh211pelmb0asn3el].[sum:Sales:qk]' scope='cols' value='false' />
